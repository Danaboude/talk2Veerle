{
  "trailingSlash": false,
  "rewrites": [
    { "source": "/((?!api/|.*\..*).*)", "destination": "/index.csr.html" }
  ],
  "headers": [
    {
      "source": "/(dashboard|create|login)(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/survey/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ]
}
